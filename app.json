{
  "expo": {
    "name": "SUUQIYE",
    "slug": "suuqplus-clean",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fursad-icon.png",
    "scheme": "suuqplus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "suuqiye.com",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "entitlements": {
        "aps-environment": "development"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "suuqiye.com",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#3F46BB",
        "backgroundImage": "./assets/images/fursad-adaptive-background.png",
        "foregroundImage": "./assets/images/fursad-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fursad-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fursad-splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#4F46E5",
          "dark": {
            "backgroundColor": "#4F46E5"
          }
        }
      ],
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SUUQIYE uses your location once, when you tap Find listings near me, to suggest your country and city. It is not stored or shared.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SUUQIYE needs access to your photos so you can add them to a listing.",
          "cameraPermission": "SUUQIYE needs access to your camera so you can take photos for a listing.",
          "microphonePermission": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": []
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c635db4-ee68-4281-9d92-2db0279c9d41"
      }
    },
    "owner": "diraxoo"
  }
}
