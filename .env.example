EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Only needed to run scripts/cleanup-r2-images.mjs (an ops script, never
# read by the app itself). It bypasses RLS on purpose, so get it fresh from
# the Supabase dashboard (Project Settings → API) when you need it rather
# than storing it here, and NEVER commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Image storage is Cloudflare R2. The client never holds any R2 credential —
# it only ever calls the r2-presign / r2-delete Supabase Edge Functions,
# which read these as server-side Edge Function secrets
# (`supabase secrets set R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=... R2_BUCKET_NAME=... R2_PUBLIC_URL=...`).
# NEVER prefix any of these EXPO_PUBLIC_ and NEVER commit real values here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
# Public delivery base for the bucket: either R2's own pub-*.r2.dev Public
# Development URL, or a custom domain connected to the bucket in the
# Cloudflare dashboard. Never the private *.r2.cloudflarestorage.com API endpoint.
R2_PUBLIC_URL=

# Photo/logo/banner check service (workers/image-scan, Cloudflare Worker). Public, non-secret: just its https URL, no trailing
# slash. Until this is set AND the Worker is deployed, business logo/banner uploads show "image service temporarily
# unavailable" (they fail closed — nothing unchecked is ever published). For EAS builds set it as an EAS environment
# variable (eas env:create) — a value in this file is not inside store builds.
EXPO_PUBLIC_IMAGE_SCAN_URL=

# Photo resizing. Public, non-secret. The https origin (no trailing slash) of the CUSTOM DOMAIN connected to the R2 bucket, on a
# Cloudflare zone with Image Transformations enabled (it must be the same host as R2_PUBLIC_URL). When set, cards request 400px,
# the carousel 800px and the gallery 1600px versions through /cdn-cgi/image/. Leave it empty on an r2.dev URL (those cannot be
# resized): photos then load at their uploaded size, exactly as before. See docs/IMAGE_DELIVERY.md. For EAS builds set it as an
# EAS environment variable (eas env:create).
EXPO_PUBLIC_IMAGE_RESIZE_BASE=
