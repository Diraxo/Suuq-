EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STREAM_API_KEY=

# Cloud name and unsigned upload preset are bundled into the client — safe to
# expose. The API key/secret must NEVER be prefixed EXPO_PUBLIC_ or read from
# client code; they're only used server-side (Supabase Edge Function secrets)
# for signed Cloudinary Admin API calls, e.g. supabase/functions/cloudinary-delete.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
