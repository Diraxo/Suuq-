{
  // Cloudflare Workers config for the SUUQIYE website (Next.js via OpenNext).
  // This only deploys the WEBSITE. It deliberately declares no R2 buckets, KV or other bindings,
  // so it cannot touch the production image bucket.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suuqiye",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
